# Built-in server as a service (put Caddy/nginx in front for HTTPS).
# Copy to /etc/systemd/system/, create the user, put the password in /etc/machado93.env as MACHADO93_AUTH=user:password
[Unit]
Description=machado93 static server
After=network.target

[Service]
User=machado93
EnvironmentFile=/etc/machado93.env
ExecStart=/bin/sh -c 'exec /usr/bin/node /opt/machado93/bin/machado93.js serve /srv/clones/current --host 127.0.0.1 --port 8080 --auth "$MACHADO93_AUTH"'
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/clones

[Install]
WantedBy=multi-user.target
