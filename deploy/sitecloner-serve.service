# Built-in server as a service (put Caddy/nginx in front for HTTPS).
# Copy to /etc/systemd/system/, create the user, put the password in /etc/sitecloner.env as SITECLONER_AUTH=user:password
[Unit]
Description=sitecloner static server
After=network.target

[Service]
User=sitecloner
EnvironmentFile=/etc/sitecloner.env
ExecStart=/bin/sh -c 'exec /usr/bin/node /opt/sitecloner/bin/sitecloner.js serve /srv/clones/current --host 127.0.0.1 --port 8080 --auth "$SITECLONER_AUTH"'
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/clones

[Install]
WantedBy=multi-user.target
